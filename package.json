{
  "name": "anyagent",
  "version": "0.1.0",
  "description": "Any coding agent. Any model. One command. Run Claude Code, Codex, OpenCode, Droid, Pi and more against OpenRouter, DeepSeek, Groq, Ollama or any OpenAI/Anthropic-compatible endpoint.",
  "keywords": [
    "ai",
    "agent",
    "cli",
    "llm",
    "claude-code",
    "codex",
    "opencode",
    "openrouter",
    "deepseek",
    "ollama",
    "byok",
    "coding-agent",
    "model-router"
  ],
  "homepage": "https://github.com/anyagent/anyagent#readme",
  "bugs": "https://github.com/anyagent/anyagent/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anyagent/anyagent.git"
  },
  "license": "MIT",
  "author": "anyagent contributors",
  "type": "module",
  "bin": {
    "anyagent": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "build": "node scripts/clean.mjs dist && tsc -p tsconfig.build.json && node scripts/postbuild.mjs",
    "dev": "node --experimental-strip-types src/cli.ts",
    "test": "node scripts/clean.mjs .test-out && tsc -p tsconfig.test.json && node scripts/copy-data.mjs .test-out/src/data && node --test \".test-out/test/*.test.js\"",
    "test:watch": "node --test --watch \".test-out/test/*.test.js\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test scripts",
    "format": "prettier --write \"**/*.{ts,mjs,json,md,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,mjs,json,md,yml}\"",
    "snapshot": "node scripts/build-snapshot.mjs",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "prepublishOnly": "npm run build",
    "docs": "node scripts/gen-docs.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
