{
  "name": "@waspdev95/anyagent",
  "version": "0.1.4",
  "description": "Run Claude Code, Codex, OpenCode and other coding agents on any model - OpenRouter, DeepSeek, Groq, Ollama or any OpenAI/Anthropic-compatible endpoint. One command instead of per-agent environment variables and config files.",
  "keywords": [
    "ai",
    "cli",
    "llm",
    "agent",
    "coding-agent",
    "claude-code",
    "codex",
    "opencode",
    "openrouter",
    "deepseek",
    "groq",
    "ollama",
    "byok",
    "model-router",
    "anthropic",
    "anthropic-base-url",
    "llm-gateway",
    "developer-tools"
  ],
  "homepage": "https://github.com/waspdev95/anyagent#readme",
  "bugs": "https://github.com/waspdev95/anyagent/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/waspdev95/anyagent.git"
  },
  "license": "MIT",
  "author": "anyagent contributors",
  "type": "module",
  "bin": {
    "anyagent": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "build": "node scripts/clean.mjs dist && tsc -p tsconfig.build.json && node scripts/postbuild.mjs",
    "dev": "node --experimental-strip-types src/cli.ts",
    "test": "node scripts/clean.mjs .test-out && tsc -p tsconfig.test.json && node scripts/copy-data.mjs .test-out/src/data && node scripts/test.mjs",
    "test:watch": "node scripts/test.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test scripts",
    "scan": "node scripts/scan-secrets.mjs --history",
    "format": "prettier --write \"**/*.{ts,mjs,json,md,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,mjs,json,md,yml}\"",
    "snapshot": "node scripts/build-snapshot.mjs",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "prepublishOnly": "npm run build",
    "docs": "node scripts/gen-docs.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
